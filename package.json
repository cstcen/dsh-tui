{
  "name": "dsh-tui",
  "version": "0.2.0",
  "description": "dsh-tui: an interactive terminal client (REPL) for the DeepSeek Harness core agent, booted as the `tui` profile over dsh-base.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./startup": {
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "install:local": "node scripts/install.mjs",
    "install:check": "node scripts/install.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "displayName": "dsh-tui 终端客户端"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "commander": "15.0.0"
  },
  "license": "MIT"
}
